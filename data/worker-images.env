# Docker Hub images for every worker's TOOL_IMAGE build arg, one manifest
# instead of editing each workers/<name>-worker/Dockerfile's ARG line
# directly. Set every line below before the first build, or `make
# check-images`/`make up`/`make build` refuse to start (see Makefile).
#
# This file is read by the `docker compose` CLI itself (via --env-file, see
# COMPOSE in the Makefile) to fill in each service's build: args: TOOL_IMAGE
# in docker-compose.yml, entirely on the host, before any image is built or
# any container exists -- unlike everything else under data/ (see its own
# README.md), this file is never bind-mounted into a container.
#
# The image must put the tool on PATH (see workers/README.md). The nmap and
# masscan images must be Debian- or Ubuntu-based, because their Dockerfiles
# install libcap2-bin with apt before calling setcap. The gowitness image
# must include Chromium.
SUBFINDER_TOOL_IMAGE=
SHUFFLEDNS_TOOL_IMAGE=
PUREDNS_TOOL_IMAGE=
MASSCAN_TOOL_IMAGE=
NMAP_TOOL_IMAGE=
METASPLOIT_TOOL_IMAGE=
DIRSEARCH_TOOL_IMAGE=
FFUF_TOOL_IMAGE=
NUCLEI_TOOL_IMAGE=
KATANA_TOOL_IMAGE=
GAU_TOOL_IMAGE=
GITLEAKS_TOOL_IMAGE=
GOWITNESS_TOOL_IMAGE=
XSSTRIKE_TOOL_IMAGE=
SQLMAP_TOOL_IMAGE=
SSTIMAP_TOOL_IMAGE=
NOSQLMAP_TOOL_IMAGE=
FUXPLOIDER_TOOL_IMAGE=
WAFW00F_TOOL_IMAGE=
JWT_TOOL_TOOL_IMAGE=
HYDRA_TOOL_IMAGE=
WPSCAN_TOOL_IMAGE=
